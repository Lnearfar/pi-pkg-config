{
  "name": "pi-pkg-manager",
  "version": "0.1.0",
  "description": "Manage enabled Pi skills and extensions across project and global scopes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lnearfar/pi-pkg-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Lnearfar/pi-pkg-manager/issues"
  },
  "homepage": "https://github.com/Lnearfar/pi-pkg-manager#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "README.md",
    "CONTEXT.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/Lnearfar/pi-pkg-manager/main/docs/images/pkg-manager.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  }
}
